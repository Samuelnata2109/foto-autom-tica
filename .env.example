# O Vite expõe variáveis VITE_* no navegador. Nunca use esse prefixo para segredos.
# Em .env.development.local, use a origem de homologação ou http://127.0.0.1:54321.
# Em .env.homologacao.local, use somente a origem do projeto de homologação.
# O workflow github-pages injeta as variáveis públicas de produção no build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Endereço público HTTPS do frontend publicado, com o subdiretório se houver.
VITE_PHOTO_SHARE_BASE_URL=
